# Behind Cloudflare, every request comes from Cloudflare's edge and the
# player's own address is in CF-Connecting-IP. Believe it only from these
# ranges (https://www.cloudflare.com/ips, as in src/http/cloudflare.ts):
# anyone else could send it to dodge the game's per-IP limits.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# DOMAIN=game.example.com gets automatic HTTPS (DNS must point here first).
# DOMAIN=:80 serves plain HTTP on the server's IP, e.g. before DNS is ready.
{$DOMAIN}

# One address per site for search engines: www.drawdle.in/x -> drawdle.in/x
# (and the same for every other www name in DOMAIN), permanently.
@www header_regexp www Host ^www\.(.+)$
redir @www https://{re.www.1}{uri} 301

# Backend, for players whose network blocks the direct game port (everyone
# else connects to the game server itself, on GAME_HOST:8443 + N). Over the
# Unix sockets the game-server processes listen on (a volume shared by both
# containers); they speak HTTPS there too, as each serves both, so the
# connection is TLS checked against GAME_HOST's own certificate. WebSocket
# upgrades pass through as-is; X-Forwarded-For is set to just the player's
# address — Cloudflare's, resolved as above, never a client-supplied chain.
#
# Process N (one per CPU core, each owning a share of the rooms) is reached at
# /s/N/socket.io; /api and a bare /socket.io go to process 0.
@shard path_regexp shard ^/s/(\d+)/socket\.io/
handle @shard {
	uri path_regexp ^/s/\d+ ""
	reverse_proxy unix//run/vmock/backend-{re.shard.1}.sock {
		transport http {
			tls
			tls_server_name {$GAME_HOST}
		}
		header_up X-Forwarded-For {client_ip}
	}
}

@backend path /api/* /socket.io/*
handle @backend {
	reverse_proxy unix//run/vmock/backend-0.sock {
		transport http {
			tls
			tls_server_name {$GAME_HOST}
		}
		header_up X-Forwarded-For {client_ip}
	}
}

# Frontend: the static bundle. Hashed assets cache forever. Pages are
# revalidated by browsers on every load, so a deploy shows on the next one,
# while Cloudflare keeps a copy at its edge for a day (Cloudflare-CDN-Cache-
# Control is read by Cloudflare alone) — close to the player, and cleared by
# every deploy (cloudflare-cache.sh purge, from autodeploy.sh).
#
# The guide pages are files like how-to-play.html, served at /how-to-play;
# any other address is the game. A missing asset is a 404, never the page:
# that would be cached for a year as the script.
handle {
	root * /srv
	encode zstd gzip
	@assets {
		path /assets/*
		file
	}
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html not path /assets/*
	header @html Cache-Control "no-cache"
	header @html Cloudflare-CDN-Cache-Control "max-age=86400"
	@page {
		not path /assets/*
		file {path} {path}.html /index.html
	}
	rewrite @page {file_match.relative}
	file_server
}

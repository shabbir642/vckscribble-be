# DOMAIN=game.example.com gets automatic HTTPS (DNS must point here first).
# DOMAIN=:80 serves plain HTTP on the server's IP, e.g. before DNS is ready.
{$DOMAIN}

# Backend: REST, and Socket.IO for players whose network blocks the direct
# game port (everyone else connects to the backend itself, on GAME_HOST:8443).
# Over the Unix socket the backend listens on (a volume shared by both
# containers); the backend speaks HTTPS there too, as one server serves both,
# so the connection is TLS checked against GAME_HOST's own certificate.
# WebSocket upgrades pass through as-is; X-Forwarded-For gets the client.
@backend path /api/* /socket.io/*
handle @backend {
	reverse_proxy unix//run/vmock/backend.sock {
		transport http {
			tls
			tls_server_name {$GAME_HOST}
		}
	}
}

# Frontend: the static bundle. Hashed assets cache forever; the HTML never
# does, so a deploy is picked up on the next page load.
handle {
	root * /srv
	encode zstd gzip
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html not path /assets/*
	header @html Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}

# Public hostname. Caddy obtains a TLS certificate for it automatically —
# point its DNS A record at this server and open ports 80 and 443 first.
# Use DOMAIN=:80 to run over plain HTTP on the bare IP instead.
DOMAIN=game.example.com

# The URL players open. Must match exactly (scheme + host).
CLIENT_ORIGIN=https://game.example.com

# Enables POST /api/words. Generate with: openssl rand -hex 24
WORDS_API_TOKEN=

# Multiplies per-IP join/connection allowances (default sized for an office
# NAT: 1000 sockets, 400-join burst). Raise for very large events.
IP_LIMIT_SCALE=1

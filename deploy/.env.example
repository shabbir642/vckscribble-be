# Public hostname(s). Caddy obtains a TLS certificate for each automatically —
# point their DNS at this server and open ports 80 and 443 first. Several
# names are comma-separated. Use DOMAIN=:80 for plain HTTP on the bare IP.
DOMAIN=vmock.fun, www.vmock.fun, drawdle.in, www.drawdle.in, play.vmock.fun, play.drawdle.in

# Players' browsers connect to the game server directly on this name and
# port, skipping the web server for game traffic: one of the names in DOMAIN.
# Open the port in the firewall (setup-server.sh does); networks that block
# it fall back to port 443. With the site behind a CDN (Cloudflare), make this
# an unproxied name of its own (DNS only), e.g. play.<site>: a CDN detour
# can add hundreds of milliseconds to every stroke.
GAME_HOST=play.vmock.fun
# More sites on the same server, comma-separated. A page connects to the name
# for its own site — the same name or a subdomain of it — so a player only
# ever depends on the site they opened. Each needs to be in DOMAIN.
EXTRA_GAME_HOSTS=play.drawdle.in
DIRECT_PORT=8443

# The URLs players open, comma-separated. Must match exactly (scheme + host).
CLIENT_ORIGIN=https://vmock.fun,https://www.vmock.fun,https://drawdle.in,https://www.drawdle.in

# Enables POST /api/words. Generate with: openssl rand -hex 24
WORDS_API_TOKEN=

# Multiplies per-IP join/connection allowances (default sized for an office
# NAT: 1000 sockets, 400-join burst). Raise for very large events.
IP_LIMIT_SCALE=1

# Who may load the website from this server (address ranges, space-separated).
# Leave it out until the site is behind Cloudflare; then
# `cloudflare-firewall.sh apply` sets it to Cloudflare's ranges and keeps them
# current (README, 8c). The game's own endpoints answer everyone regardless.
# SITE_ONLY_FROM=

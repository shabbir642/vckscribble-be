{
  "name": "vckscribble-be",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed-run.ts",
    "smoke": "node scripts/smoke.mjs",
    "smoke:game": "node scripts/smoke-game.mjs",
    "smoke:guess": "node scripts/smoke-guess.mjs",
    "smoke:all": "node scripts/smoke.mjs && node scripts/smoke-game.mjs && node scripts/smoke-guess.mjs && node scripts/smoke-join.mjs && node scripts/smoke-roster.mjs && node scripts/smoke-errors.mjs && node scripts/smoke-identity.mjs && node scripts/smoke-host.mjs && node scripts/smoke-words.mjs",
    "smoke:join": "node scripts/smoke-join.mjs",
    "smoke:roster": "node scripts/smoke-roster.mjs",
    "smoke:errors": "node scripts/smoke-errors.mjs",
    "smoke:identity": "node scripts/smoke-identity.mjs",
    "smoke:host": "node scripts/smoke-host.mjs",
    "smoke:words": "node scripts/smoke-words.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.38.3",
    "express": "^4.21.2",
    "nanoid": "^5.0.9",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
